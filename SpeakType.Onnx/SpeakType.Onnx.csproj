<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- ONNX Runtime (CPU); the single package ships native libs for win/linux/osx. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
    <!-- Native HF tokenizer runtimes for every platform we build/test/ship on
         (dev: osx; CI: linux/windows; app: win-x64). The host RID's native is
         resolved at runtime; the others are inert. -->
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-arm64" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-x64" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.linux-x64" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- T5/CoEdIT SentencePiece tokenizer (~2.4 MB; the ~2.4 GB model downloads separately).
         Embedded (not Content) so it survives a single-file publish — content files would be
         emitted beside the exe and lost when only the exe ships. CoEditTokenizer extracts it to
         a per-user cache file at load (Tokenizers.DotNet requires a path). LogicalName fixes the
         manifest resource name for the runtime lookup. -->
    <EmbeddedResource Include="assets\tokenizer.json" LogicalName="tokenizer.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeakType.Core\SpeakType.Core.csproj" />
  </ItemGroup>

</Project>
