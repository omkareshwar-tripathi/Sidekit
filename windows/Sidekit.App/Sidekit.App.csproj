<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sidekit.App</RootNamespace>
    <AssemblyName>Sidekit</AssemblyName>
    <!-- Required by [LibraryImport] source-generated P/Invoke (SYSLIB1062). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Packaging (spec Feature 26): self-contained single-file win-x64 exe. The native whisper.cpp
         libraries (Whisper.net.Runtime) would otherwise be dropped beside the exe; embed + self-extract
         them so the documented publish command produces ONE file. Only takes effect during a
         single-file publish, so it's inert for normal build/test. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Brand logo (Brick UI-6): the .exe icon. The same file is embedded below so the windows
         and tray can load it at runtime. -->
    <ApplicationIcon>Assets\sidekit.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- LogicalName makes the runtime lookup name deterministic (AppIcon.Brand loads "sidekit.ico"). -->
    <EmbeddedResource Include="Assets\sidekit.ico" LogicalName="sidekit.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Native whisper.cpp libraries so Whisper actually runs in the deployed app; the managed
         Whisper.net comes transitively via the Sidekit.Whisper project reference. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sidekit.Core\Sidekit.Core.csproj" />
    <ProjectReference Include="..\Sidekit.Whisper\Sidekit.Whisper.csproj" />
  </ItemGroup>
</Project>
