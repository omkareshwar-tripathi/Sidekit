<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SpeakType.App</RootNamespace>
    <AssemblyName>SpeakType</AssemblyName>
    <!-- Required by [LibraryImport] source-generated P/Invoke (SYSLIB1062). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Packaging (spec Feature 26): self-contained single-file win-x64 exe. The native whisper.cpp
         libraries (Whisper.net.Runtime) would otherwise be dropped beside the exe; embed + self-extract
         them so the documented publish command produces ONE file. Only takes effect during a
         single-file publish, so it's inert for normal build/test. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compress the embedded bundle. CoEdIT's ONNX Runtime + tokenizer natives roughly doubled
         the exe (66 MB -> 175 MB uncompressed); compression ~halves it for a small one-time
         decompress at launch (negligible for a tray app). Single-file publish only. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Brand logo (Brick UI-6): the .exe icon. The same file is embedded below so the windows
         and tray can load it at runtime. -->
    <ApplicationIcon>Assets\speaktype.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- LogicalName makes the runtime lookup name deterministic (AppIcon.Brand loads "speaktype.ico"). -->
    <EmbeddedResource Include="Assets\speaktype.ico" LogicalName="speaktype.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Native whisper.cpp libraries so Whisper actually runs in the deployed app; the managed
         Whisper.net comes transitively via the SpeakType.Whisper project reference. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpeakType.Core\SpeakType.Core.csproj" />
    <ProjectReference Include="..\SpeakType.Whisper\SpeakType.Whisper.csproj" />
    <!-- CoEdIT on-device text polishing. Brings in ONNX Runtime + Tokenizers.DotNet native
         libraries (win-x64) and the bundled assets\tokenizer.json content. -->
    <ProjectReference Include="..\SpeakType.Onnx\SpeakType.Onnx.csproj" />
  </ItemGroup>

  <!-- Bake the default speech model (ggml-base.en.bin, ~148 MB) into the exe so first run needs no
       download; Program.TryInstallBundledSpeechModel materializes it. The file must exist at MSBuild
       EVALUATION time to embed (a file created by an in-build target is NOT embedded — the resource
       list is snapshotted before any target runs), so it is fetched into .bundled/ BEFORE the build:
       the CI "Download speech model" step does this (cached across runs). When the file is absent
       (a plain local build), the build still succeeds and the app falls back to the first-run download.
       WithCulture=false is REQUIRED: the SDK otherwise reads the ".en." in the filename as an English
       culture suffix and routes the resource to a satellite assembly instead of embedding it. -->
  <PropertyGroup>
    <SpeechModelFile>$(MSBuildProjectDirectory)/.bundled/ggml-base.en.bin</SpeechModelFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(SpeechModelFile)')">
    <EmbeddedResource Include="$(SpeechModelFile)" LogicalName="ggml-base.en.bin" WithCulture="false" Visible="false" />
  </ItemGroup>
</Project>
