<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SpeakType.App</RootNamespace>
    <AssemblyName>SpeakType</AssemblyName>
    <!-- Required by [LibraryImport] source-generated P/Invoke (SYSLIB1062). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Packaging (spec Feature 26): self-contained single-file win-x64 exe. The native whisper.cpp
         libraries (Whisper.net.Runtime) would otherwise be dropped beside the exe; embed + self-extract
         them so the documented publish command produces ONE file. Only takes effect during a
         single-file publish, so it's inert for normal build/test. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Brand logo (Brick UI-6): the .exe icon. The same file is embedded below so the windows
         and tray can load it at runtime. -->
    <ApplicationIcon>Assets\speaktype.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- LogicalName makes the runtime lookup name deterministic (AppIcon.Brand loads "speaktype.ico"). -->
    <EmbeddedResource Include="Assets\speaktype.ico" LogicalName="speaktype.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Native whisper.cpp libraries so Whisper actually runs in the deployed app; the managed
         Whisper.net comes transitively via the SpeakType.Whisper project reference. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpeakType.Core\SpeakType.Core.csproj" />
    <ProjectReference Include="..\SpeakType.Whisper\SpeakType.Whisper.csproj" />
    <!-- CoEdIT on-device text polishing. Brings in ONNX Runtime + Tokenizers.DotNet native
         libraries (win-x64) and the bundled assets\tokenizer.json content. -->
    <ProjectReference Include="..\SpeakType.Onnx\SpeakType.Onnx.csproj" />
  </ItemGroup>
</Project>
