# macOS
.DS_Store

# SpeakType runtime artifacts (never commit these)
# Whisper model files are large and downloaded at runtime
*.bin
# Only a repo-root models/ dir (stray local downloads); the runtime store lives in
# %LOCALAPPDATA%. Anchored so it does not clobber source folders like Core/Models/.
/models/
# Local logs
logs/

# Python bytecode (export tooling)
__pycache__/
*.pyc

# Local model/whisper eval scratch (multi-GB, never commit)
/lab/

# Build-in-public drafts — kept local, not part of the public repo
/bip-posts/

# Project Atlas — volatile derived data (regenerated by .atlas/sync.js on every run).
# Everything else under .atlas/ IS committed so the board travels with the repo;
# only these two are machine-/moment-specific. environment.json stays committed on
# purpose — it carries the view of machine-local AI config into the cloud.
.atlas/data/git.json
.atlas/data/pending.json

# Code map output (generated on demand by /graphify)
graphify-out/
